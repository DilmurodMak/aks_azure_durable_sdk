tml=1;fillColor=#ffffff;strokeColor=#326CE5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#326CE5;fontSize=12;container=1;collapsible=0;" vertex="1" parent="c_azure"><mxGeometry x="20" y="45" width="430" height="255" as="geometry"/></mxCell><mxCell id="n_aks" value="&lt;b&gt;AKS&lt;/b&gt;" style="image;aspect=fixed;points=[];image=img/lib/azure2/containers/Kubernetes_Services.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_aks"><mxGeometry x="15" y="30" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_pod" value="&lt;b&gt;worker pod&lt;/b&gt;" style="aspect=fixed;sketch=0;dashed=0;fillColor=#326CE5;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;prIcon=pod;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_aks"><mxGeometry x="15" y="120" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_wbox" value="&lt;b&gt;approval-worker (.NET, Docker image)&lt;/b&gt;&lt;br&gt;ApprovalChain → ApprovalStep (×N)&lt;br&gt;RecordSubmission · RecordDecision&lt;br&gt;· ApplyDecision&lt;br&gt;workload identity" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_aks"><mxGeometry x="110" y="45" width="300" height="108" as="geometry"/></mxCell><mxCell id="n_acr" value="&lt;b&gt;Azure Container Registry&lt;/b&gt;" style="image;aspect=fixed;points=[];image=img/lib/azure2/containers/Container_Registries.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_azure"><mxGeometry x="60" y="380" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_ai" value="&lt;b&gt;Application Insights&lt;/b&gt;&lt;br&gt;traces" style="image;aspect=fixed;points=[];image=img/lib/azure2/devops/Application_Insights.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_azure"><mxGeometry x="256" y="380" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_dts" value="&lt;b&gt;Azure Durable Task Scheduler&lt;/b&gt;&lt;br&gt;managed by Microsoft&lt;br&gt;state · timers · history" style="shape=image;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_azure"><mxGeometry x="560" y="90" width="56" height="56" as="geometry"/></mxCell><mxCell id="n_dash" value="&lt;b&gt;Scheduler dashboard (built in)&lt;/b&gt;&lt;br&gt;Entra sign-in · tag filter" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_azure"><mxGeometry x="496" y="242" width="222" height="46" as="geometry"/></mxCell><mxCell id="n_entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;+ Azure RBAC" style="image;aspect=fixed;points=[];image=img/lib/azure2/identity/Azure_Active_Directory.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_azure"><mxGeometry x="830" y="94" width="48" height="48" as="geometry"/></mxCell><mxCell id="c_add" value="Later: policy and audit store" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8886;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#8a8886;fontSize=12;container=1;collapsible=0;dashed=1;" vertex="1" parent="c_azure"><mxGeometry x="490" y="370" width="500" height="160" as="geometry"/></mxCell><mxCell id="n_sql" value="&lt;b&gt;Azure SQL&lt;/b&gt;" style="image;aspect=fixed;points=[];image=img/lib/azure2/databases/SQL_Database.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;opacity=80;" vertex="1" parent="c_add"><mxGeometry x="100" y="45" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_cos" value="&lt;b&gt;or Cosmos DB&lt;/b&gt;" style="image;aspect=fixed;points=[];image=img/lib/azure2/databases/Azure_Cosmos_DB.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;opacity=80;" vertex="1" parent="c_add"><mxGeometry x="340" y="45" width="48" height="48" as="geometry"/></mxCell><mxCell id="c_code" value="Code path — Client → Orchestrator → Sub-orchestrator → Activity (same locally and on AKS)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#c19c00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#c19c00;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1460" height="160" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;1 · Client (Console)&lt;/b&gt;&lt;br&gt;ScheduleNewOrchestrationInstanceAsync&lt;br&gt;RaiseEventAsync(&amp;quot;Decision&amp;quot;)&lt;br&gt;SoD check → 409 before start" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#107c10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_code"><mxGeometry x="20" y="30" width="330" height="82" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;2 · ApprovalChain (orchestrator)&lt;/b&gt;&lt;br&gt;stages in order, reviewers in parallel&lt;br&gt;CallSubOrchestratorAsync(ApprovalStep)&lt;br&gt;reject / return / timeout → stop" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_code"><mxGeometry x="390" y="30" width="330" height="82" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;3 · ApprovalStep (×N)&lt;/b&gt;&lt;br&gt;timer + wait for &amp;quot;Decision&amp;quot;&lt;br&gt;checks approver, version, comment&lt;br&gt;returns Approved / Rejected / …" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_code"><mxGeometry x="760" y="30" width="340" height="82" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;4 · Activities (side effects)&lt;/b&gt;&lt;br&gt;RecordSubmission · RecordDecision&lt;br&gt;ApplyDecision&lt;br&gt;must be idempotent" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3ecfb;strokeColor=#773adc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_code"><mxGeometry x="1140" y="30" width="300" height="82" as="geometry"/></mxCell><mxCell id="c_diff" value="Key differences: the numbers match the orange badges above and the other engine’s diagram" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffaf7;strokeColor=#D83B01;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#D83B01;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="805" width="1460" height="135" as="geometry"/></mxCell><mxCell id="df1" value="&lt;b&gt;① Engine and its state&lt;/b&gt;&lt;br&gt;Microsoft runs the scheduler; state and&lt;br&gt;history live inside it (kept ≤ 90 days)&lt;br&gt;Temporal: our server + our PostgreSQL" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="20" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="df2" value="&lt;b&gt;② How a decision gets in&lt;/b&gt;&lt;br&gt;External event: fire-and-forget; caller&lt;br&gt;hears “sent, not yet applied”&lt;br&gt;Temporal: Signal or Update (instant reply)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="308" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="df3" value="&lt;b&gt;③ Ops console and search&lt;/b&gt;&lt;br&gt;Scheduler dashboard behind Entra; tags&lt;br&gt;fixed at start, dashboard filter only&lt;br&gt;Temporal: Web UI we host; API filters" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="596" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="df4" value="&lt;b&gt;④ If the AKS cluster goes down&lt;/b&gt;&lt;br&gt;Workers stop; the scheduler and its&lt;br&gt;state keep running outside the cluster&lt;br&gt;Temporal: engine and workers stop together" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="884" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="df5" value="&lt;b&gt;⑤ Access and security&lt;/b&gt;&lt;br&gt;Entra ID + Azure RBAC per task hub;&lt;br&gt;workload identity for the worker&lt;br&gt;Temporal: mTLS + authorizer we configure" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="1172" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#605e5c;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.552;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_user" target="n_console"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;stroke