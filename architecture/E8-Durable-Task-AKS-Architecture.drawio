<mxfile host="app.diagrams.net" type="device"><diagram id="Durable-Task-on-AKS" name="Durable Task on AKS"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="955" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;E8 approvals — Durable Task SDK (.NET) on AKS + Azure Durable Task Scheduler (managed)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c_local" value="Developer machine — local demo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8a8886;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#8a8886;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="430" height="560" as="geometry"/></mxCell><mxCell id="n_user" value="&lt;b&gt;Tester&lt;/b&gt;" style="image;aspect=fixed;points=[];image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_local"><mxGeometry x="20" y="50" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_console" value="&lt;b&gt;Console UI — the client&lt;/b&gt;&lt;br&gt;:5080 → emulator · :5081 → Azure" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#107c10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_local"><mxGeometry x="100" y="42" width="310" height="58" as="geometry"/></mxCell><mxCell id="n_policy" value="&lt;b&gt;Policy chain (local JSON)&lt;/b&gt;&lt;br&gt;→ SQL / Cosmos DB later" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b8860b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent=