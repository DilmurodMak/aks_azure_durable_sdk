<mxfile host="app.diagrams.net" type="device"><diagram id="Temporal:-Compose-today,-AKS-target" name="Temporal: Compose today, AKS target"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="955" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;E8 approvals — Temporal (Python SDK): spike today in Docker Compose · target self-hosted on AKS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c_local" value="Developer machine — the spike today" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8a8886;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#8a8886;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="430" height="560" as="geometry"/></mxCell><mxCell id="n_user" value="&lt;b&gt;Tester&lt;/b&gt;" style="image;aspect=fixed;points=[];image=img/lib/azure2/identity/Users.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_local"><mxGeometry x="20" y="50" width="48" height="48" as="geometry"/></mxCell><mxCell id="c_box" value="Docker Desktop (Compose)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eaf6fd;strokeColor=#2496ED;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#2496ED;fontSize=12;container=1;collapsible=0;" vertex="1" parent="c_local"><mxGeometry x="90" y="25" width="320" height="515" as="geometry"/></mxCell><mxCell id="n_console" value="&lt;b&gt;Console — FastAPI :5090 (client)&lt;/b&gt;&lt;br&gt;policy chain in local JSON" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#107c10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_box"><mxGeometry x="15" y="30" width="290" height="58" as="geometry"/></mxCell><mxCell id="n_eng" value="&lt;b&gt;Temporal Server&lt;/b&gt;&lt;br&gt;container · gRPC :7233" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_box"><mxGeometry x="30" y="150" width="140" height="48" as="geometry"/></mxCell><mxCell id="n_ldash" value="&lt;b&gt;Temporal UI&lt;/b&gt;&lt;br&gt;:8088" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_box"><mxGeometry x="190" y="150" width="115" height="48" as="geometry"/></mxCell><mxCell id="n_lpg" value="&lt;b&gt;PostgreSQL 16 container&lt;/b&gt;&lt;br&gt;execution + visibility" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b8860b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_box"><mxGeometry x="120" y="265" width="185" height="48" as="geometry"/></mxCell><mxCell id="n_lworker" value="&lt;b&gt;approval worker (Python)&lt;/b&gt;&lt;br&gt;same image as on AKS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_box"><mxGeometry x="15" y="425" width="290" height="58" as="geometry"/></mxCell><mxCell id="c_azure" value="Azure — target (not deployed yet)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f0f6fc;strokeColor=#0078D4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#0078D4;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="470" y="50" width="1010" height="560" as="geometry"/></mxCell><mxCell id="c_aks" value="AKS cluster" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326CE5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#326CE5;fontSize=12;container=1;collapsible=0;" vertex="1" parent="c_azure"><mxGeometry x="20" y="45" width="560" height="255" as="geometry"/></mxCell><mxCell id="n_aks" value="&lt;b&gt;AKS&lt;/b&gt;" style="image;aspect=fixed;points=[];image=img/lib/azure2/containers/Kubernetes_Services.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_aks"><mxGeometry x="15" y="30" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_tsrv" value="&lt;b&gt;Temporal Server (Helm chart)&lt;/b&gt;&lt;br&gt;Frontend · History · Matching&lt;br&gt;· internal worker" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_aks"><mxGeometry x="80" y="45" width="245" height="100" as="geometry"/></mxCell><mxCell id="n_wbox" value="&lt;b&gt;approval-worker pod&lt;/b&gt;&lt;br&gt;Python image&lt;br&gt;task queue approval" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_aks"><mxGeometry x="355" y="45" width="185" height="100" as="geometry"/></mxCell><mxCell id="n_webui" value="&lt;b&gt;Temporal Web UI&lt;/b&gt;&lt;br&gt;we host and secure it" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_aks"><mxGeometry x="355" y="167" width="185" height="56" as="geometry"/></mxCell><mxCell id="n_access" value="&lt;b&gt;Access: mTLS + authorizer plugin&lt;/b&gt;&lt;br&gt;we configure it; Entra wiring is ours" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8886;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_azure"><mxGeometry x="710" y="60" width="270" height="58" as="geometry"/></mxCell><mxCell id="n_pg" value="&lt;b&gt;Azure Database for PostgreSQL&lt;/b&gt;&lt;br&gt;flexible server&lt;br&gt;execution + visibility databases&lt;br&gt;we size, back up, upgrade" style="image;aspect=fixed;points=[];image=img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_azure"><mxGeometry x="730" y="250" width="56" height="56" as="geometry"/></mxCell><mxCell id="n_acr" value="&lt;b&gt;Azure Container Registry&lt;/b&gt;" style="image;aspect=fixed;points=[];image=img/lib/azure2/containers/Container_Registries.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_azure"><mxGeometry x="60" y="380" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_mon" value="&lt;b&gt;Azure Monitor&lt;/b&gt;&lt;br&gt;Prometheus + App Insights" style="image;aspect=fixed;points=[];image=img/lib/azure2/management_governance/Monitor.svg;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;whiteSpace=wrap;" vertex="1" parent="c_azure"><mxGeometry x="256" y="380" width="48" height="48" as="geometry"/></mxCell><mxCell id="n_owncap" value="We operate all of it: server upgrades, database schema migrations, backups and restore tests, mTLS, alerts." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#605e5c;whiteSpace=wrap;" vertex="1" parent="c_azure"><mxGeometry x="30" y="510" width="940" height="18" as="geometry"/></mxCell><mxCell id="c_code" value="Code path — Client → Workflow → Child workflow → Activity (same in Compose and on AKS)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#c19c00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#c19c00;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1460" height="160" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;1 · Client (FastAPI console)&lt;/b&gt;&lt;br&gt;client.start_workflow(ApprovalChain)&lt;br&gt;handle.signal(&amp;quot;Decision&amp;quot;)&lt;br&gt;SoD check → 409 before start" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e7f6ec;strokeColor=#107c10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_code"><mxGeometry x="20" y="30" width="330" height="82" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;2 · ApprovalChain (workflow)&lt;/b&gt;&lt;br&gt;stages in order, reviewers in parallel&lt;br&gt;start_child_workflow(ApprovalStep)&lt;br&gt;reject / return / timeout → stop" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_code"><mxGeometry x="390" y="30" width="330" height="82" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;3 · ApprovalStep (×N)&lt;/b&gt;&lt;br&gt;wait_condition(decided, timeout)&lt;br&gt;checks approver, version, comment&lt;br&gt;returns Approved / Rejected / …" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#0078D4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_code"><mxGeometry x="760" y="30" width="340" height="82" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;4 · Activities (side effects)&lt;/b&gt;&lt;br&gt;RecordSubmission · RecordDecision&lt;br&gt;ApplyDecision (retries 3×)&lt;br&gt;must be idempotent" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f3ecfb;strokeColor=#773adc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_code"><mxGeometry x="1140" y="30" width="300" height="82" as="geometry"/></mxCell><mxCell id="c_diff" value="Key differences: the numbers match the orange badges above and the other engine’s diagram" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffaf7;strokeColor=#D83B01;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontColor=#D83B01;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="805" width="1460" height="135" as="geometry"/></mxCell><mxCell id="df1" value="&lt;b&gt;① Engine and its state&lt;/b&gt;&lt;br&gt;We run Temporal Server and PostgreSQL;&lt;br&gt;retention is our setting (and DB cost)&lt;br&gt;Durable: Microsoft runs both" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="20" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="df2" value="&lt;b&gt;② How a decision gets in&lt;/b&gt;&lt;br&gt;Signal today (fire-and-forget); an Update&lt;br&gt;with a validator can accept or refuse&lt;br&gt;Durable: external event only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="308" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="df3" value="&lt;b&gt;③ Ops console and search&lt;/b&gt;&lt;br&gt;Web UI we host and secure; search&lt;br&gt;attributes update as the flow moves&lt;br&gt;Durable: dashboard + fixed tags" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="596" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="df4" value="&lt;b&gt;④ If the AKS cluster goes down&lt;/b&gt;&lt;br&gt;Engine, UI and workers stop together;&lt;br&gt;state is safe in PostgreSQL outside AKS&lt;br&gt;Durable: the scheduler keeps running" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="884" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="df5" value="&lt;b&gt;⑤ Access and security&lt;/b&gt;&lt;br&gt;TLS/mTLS + an authorizer plugin that&lt;br&gt;we configure; Entra wiring is ours&lt;br&gt;Durable: Entra ID + Azure RBAC built in" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff4ec;strokeColor=#D83B01;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="c_diff"><mxGeometry x="1172" y="30" width="272" height="90" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#605e5c;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.328;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_user" target="n_console"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#605e5c;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.293;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_console" target="n_eng"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#605e5c;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_ldash" target="n_eng"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=